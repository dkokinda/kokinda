# HTTP port the bot listens on
PORT=3000

# BlueBubbles server (the Mac-side bridge that exposes iMessage over HTTP)
BLUEBUBBLES_SERVER_URL=http://localhost:1234
BLUEBUBBLES_PASSWORD=changeme

# Shared secret appended as ?token=... to the webhook URL registered in BlueBubbles
WEBHOOK_TOKEN=changeme

# Anthropic API (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Max number of messages (user + assistant) kept per chat as conversation context
MAX_HISTORY_MESSAGES=30
