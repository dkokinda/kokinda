PORT=3100

# Azure app registration (Entra ID) -> Application (client) ID.
# https://portal.azure.com -> Microsoft Entra ID -> App registrations -> New registration
GRAPH_CLIENT_ID=

# Directory (tenant) ID. Use the tenant GUID for a work/school account, or
# "organizations" to accept any work/school tenant. Planner does NOT support
# personal Microsoft accounts, so do not use "consumers" here.
GRAPH_TENANT_ID=organizations

# device_code  -> delegated, acts as the signed-in user. Run `npm run login`
#                 once; the refresh token is cached and reused unattended.
# client_credentials -> app-only, no user. Needs Tasks.ReadWrite.All
#                 *application* permission plus tenant admin consent.
GRAPH_AUTH_MODE=device_code

# Only needed when GRAPH_AUTH_MODE=client_credentials.
GRAPH_CLIENT_SECRET=

# Delegated scopes. offline_access is required to get a refresh token.
GRAPH_SCOPES=offline_access User.Read Tasks.ReadWrite Group.Read.All

# Where the delegated refresh token is cached. Keep this out of git.
GRAPH_TOKEN_CACHE_PATH=.tokens.json

# Usually fine to leave at their defaults.
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_AUTHORITY_HOST=https://login.microsoftonline.com
