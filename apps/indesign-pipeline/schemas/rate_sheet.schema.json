{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rate / Room-Type Sheet",
  "type": "object",
  "required": ["property_name", "season_label", "room_types"],
  "properties": {
    "property_name": { "type": "string" },
    "season_label": { "type": "string" },
    "valid_from": { "type": "string", "format": "date" },
    "valid_to": { "type": "string", "format": "date" },
    "room_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "rate"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "max_occupancy": { "type": "integer" },
          "rate": { "type": "string" },
          "rate_basis": { "type": "string", "default": "per night" }
        }
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "rate"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "rate": { "type": "string" },
          "inclusions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
