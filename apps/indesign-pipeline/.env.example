PORT=3000

# Adobe Developer Console -> OAuth Server-to-Server credentials for the
# InDesign API product (Firefly Services).
# https://developer.adobe.com/firefly-services/docs/indesign-apis/getting-started/
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_ORG_ID=

# Usually fine to leave at their defaults.
ADOBE_IMS_TOKEN_URL=https://ims-na1.adobelogin.com/ims/token/v3
ADOBE_IMS_SCOPES=openid,AdobeID,indesign_services,creative_sdk
ADOBE_INDESIGN_API_BASE_URL=https://indesign.adobe.io

# Operation paths. Adobe's InDesign API can expose capability-bundle-scoped
# routes that vary by Developer Console project/API version - verify these
# against your project's API reference and override here if they differ.
ADOBE_OP_CREATE_RENDITION=/v3/create-rendition
ADOBE_OP_MERGE_DATA_TAGS=/v3/merge-data-tags
ADOBE_OP_MERGE_DATA=/v3/merge-data
ADOBE_OP_CONVERT_PDF_TO_INDD=/v3/convert-pdf-to-indd
ADOBE_OP_STATUS=/v3/status

JOB_POLL_INTERVAL_MS=2000
JOB_POLL_TIMEOUT_MS=120000
