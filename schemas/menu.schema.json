{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Restaurant / Room-Service Menu",
  "type": "object",
  "required": ["outlet_name", "sections"],
  "properties": {
    "outlet_name": { "type": "string" },
    "service_hours": { "type": "string" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["heading", "items"],
        "properties": {
          "heading": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "price"],
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "price": { "type": "string" },
                "dietary_tags": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "footnote": { "type": "string" }
  }
}
