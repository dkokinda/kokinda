{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "In-Room Directory / Guest Info",
  "type": "object",
  "required": ["property_name", "sections"],
  "properties": {
    "property_name": { "type": "string" },
    "wifi": {
      "type": "object",
      "properties": {
        "network_name": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "emergency_contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "extension"],
        "properties": {
          "label": { "type": "string" },
          "extension": { "type": "string" }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["heading", "entries"],
        "properties": {
          "heading": { "type": "string" },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "hours": { "type": "string" },
                "extension": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
